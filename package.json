{
  "name": "@tspub-dev/tspub",
  "version": "1.0.0",
  "description": "The unified TypeScript package toolkit — init, build, check, publish in one tool. tspub builds itself.",
  "type": "module",
  "bin": {
    "tspub": "./dist/bin/tspub.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./test-d": {
      "import": {
        "types": "./dist/type-tester/assertions.d.ts",
        "default": "./dist/type-tester/assertions.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.cts",
    "!dist/src",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "test -f dist/bin/tspub.js || node scripts/bootstrap.js && node dist/bin/tspub.js build",
    "dev": "node dist/bin/tspub.js build --watch",
    "bootstrap": "node scripts/bootstrap.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ecosystem": "vitest run --config vitest.ecosystem.config.ts",
    "lint": "oxlint src/ bin/ test/",
    "typecheck": "tsc --noEmit",
    "check": "node ./dist/bin/tspub.js check",
    "prepublishOnly": "pnpm run build && pnpm run check",
    "release:patch": "pnpm version patch && git push --follow-tags",
    "release:minor": "pnpm version minor && git push --follow-tags",
    "release:major": "pnpm version major && git push --follow-tags",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:e2e-remote": "playwright test --config test/e2e-remote/playwright.config.ts",
    "prepare": "test -d .git && lefthook install || true"
  },
  "keywords": [
    "typescript",
    "publish",
    "package",
    "build",
    "check",
    "npm",
    "esm",
    "cjs",
    "exports"
  ],
  "author": "Anish Giri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tspub/tspub.git"
  },
  "homepage": "https://github.com/tspub/tspub#readme",
  "bugs": {
    "url": "https://github.com/tspub/tspub/issues"
  },
  "sideEffects": false,
  "dependencies": {
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "esbuild": "^0.27.2",
    "fast-glob": "^3.3.3",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@vercel/node": "^5.1.0",
    "@vercel/og": "^0.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fflate": "^0.8.2",
    "lefthook": "^2.1.1",
    "oxlint": "^1.16.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
